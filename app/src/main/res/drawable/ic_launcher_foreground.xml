<?xml version="1.0" encoding="utf-8"?>
<!-- 终端屏:phosphor 绿圆角边框(CRT 屏框) + 框内居中的小号 ">_" 提示符。
     边框/字均收在自适应图标安全区内,避免被各家圆/方遮罩裁切。
     整体被 <monochrome> 复用 → Android 13+ 主题图标自动取其形状着色。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 一圈圆角边框(屏框) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#41FF8F"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:pathData="M34,18 L74,18 Q90,18 90,34 L90,74 Q90,90 74,90 L34,90 Q18,90 18,74 L18,34 Q18,18 34,18 Z" />
    <!-- > 尖括号(小一号) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#41FF8F"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,42 L54,54 L40,66" />
    <!-- _ 光标(下划线) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#41FF8F"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M56,66 L68,66" />
</vector>
